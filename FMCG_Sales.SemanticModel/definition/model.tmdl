model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures

annotation PBI_QueryOrder = ["Date","Area","Sales Officer","Distributor","Category","Product","Primary Sales","Secondary Sales","Targets","Coverage","Refresh Info","SQL Server","SQL Database"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Date
ref table Area
ref table 'Sales Officer'
ref table Distributor
ref table Category
ref table Product
ref table 'Primary Sales'
ref table 'Secondary Sales'
ref table Targets
ref table Coverage
ref table 'Refresh Info'

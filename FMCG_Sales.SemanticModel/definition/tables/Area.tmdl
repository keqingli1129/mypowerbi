/// Sales areas at area sales manager (ASM) grain, with regional sales manager (RSM) and zone.
table Area

	column Zone
		dataType: string
		sourceColumn: zone

	column RSM
		dataType: string
		sourceColumn: rsm

	column ASM
		dataType: string
		isKey
		sourceColumn: asm

	hierarchy 'Sales Hierarchy'

		level Zone
			column: Zone

		level RSM
			column: RSM

		level ASM
			column: ASM

	partition Area = m
		mode: import
		source =
				let
					// Azure Databricks connector: warehouse -> catalog -> schema -> table
					Source = Databricks.Catalogs(#"Databricks Host", #"Databricks HTTP Path", [Catalog = null, Database = null]),
					Catalog = Source{[Name = #"Databricks Catalog", Kind = "Database"]}[Data],
					Schema = Catalog{[Name = #"Databricks Schema", Kind = "Schema"]}[Data],
					Table = Schema{[Name = "area", Kind = "Table"]}[Data]
				in
					Table

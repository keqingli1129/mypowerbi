/// Sales areas at area sales manager (ASM) grain, with regional sales manager (RSM) and zone.
table Area

	column Zone
		dataType: string
		sourceColumn: zone

	column RSM
		dataType: string
		sourceColumn: rsm

	column ASM
		dataType: string
		isKey
		sourceColumn: asm

	hierarchy 'Sales Hierarchy'

		level Zone
			column: Zone

		level RSM
			column: RSM

		level ASM
			column: ASM

	partition Area = m
		mode: import
		source =
				let
					// SQL Server connector: server + database -> schema.table
					Source = Sql.Database(#"SQL Server", #"SQL Database"),
					Table = Source{[Schema = "fmcg", Item = "area"]}[Data]
				in
					Table

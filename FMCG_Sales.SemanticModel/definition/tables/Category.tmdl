/// Product categories, shared by sales and targets.
table Category

	column Category
		dataType: string
		isKey
		sourceColumn: category

	partition Category = m
		mode: import
		source =
				let
					// SQL Server connector: server + database -> schema.table
					Source = Sql.Database(#"SQL Server", #"SQL Database"),
					Table = Source{[Schema = "fmcg", Item = "category"]}[Data]
				in
					Table

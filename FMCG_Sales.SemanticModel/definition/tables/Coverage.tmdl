/// Monthly outlet coverage and call productivity per sales officer × city (dated the first of the month).
table Coverage

	/// Outlets billed ÷ total outlets: width of retail reach.
	measure 'Numeric Distribution %' = DIVIDE ( SUM ( Coverage[Outlets Billed] ), SUM ( Coverage[Total Outlets] ) )
		formatString: 0.0%
		displayFolder: Coverage

	/// Productive calls ÷ planned calls: salesman efficiency on the beat.
	measure 'Productive Call %' = DIVIDE ( SUM ( Coverage[Productive Calls] ), SUM ( Coverage[Planned Calls] ) )
		formatString: 0.0%
		displayFolder: Coverage

	/// Average SKUs per bill, weighted by outlets billed.
	measure 'Avg Lines per Bill' = ```
			DIVIDE (
			    SUMX ( Coverage, Coverage[Lines Per Bill] * Coverage[Outlets Billed] ),
			    SUM ( Coverage[Outlets Billed] )
			)
			```
		formatString: 0.0
		displayFolder: Coverage

	column Date
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: date

	column ASM
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: asm

	column 'Sales Officer'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: sales_officer

	column 'Total Outlets'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: total_outlets

	column 'Outlets Billed'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: outlets_billed

	column 'Planned Calls'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: planned_calls

	column 'Productive Calls'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: productive_calls

	column 'Lines Per Bill'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: lines_per_bill

	partition Coverage = m
		mode: import
		source =
				let
					// Azure Databricks connector: warehouse -> catalog -> schema -> table
					Source = Databricks.Catalogs(#"Databricks Host", #"Databricks HTTP Path", [Catalog = null, Database = null]),
					Catalog = Source{[Name = #"Databricks Catalog", Kind = "Database"]}[Data],
					Schema = Catalog{[Name = #"Databricks Schema", Kind = "Schema"]}[Data],
					Table = Schema{[Name = "coverage", Kind = "Table"]}[Data]
				in
					Table

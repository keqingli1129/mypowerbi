/// Monthly outlet coverage and call productivity per sales officer × city (dated the first of the month).
table Coverage

	/// Outlets billed ÷ total outlets: width of retail reach.
	measure 'Numeric Distribution %' = DIVIDE ( SUM ( Coverage[Outlets Billed] ), SUM ( Coverage[Total Outlets] ) )
		formatString: 0.0%
		displayFolder: Coverage

	/// Productive calls ÷ planned calls: salesman efficiency on the beat.
	measure 'Productive Call %' = DIVIDE ( SUM ( Coverage[Productive Calls] ), SUM ( Coverage[Planned Calls] ) )
		formatString: 0.0%
		displayFolder: Coverage

	/// Average SKUs per bill, weighted by outlets billed.
	measure 'Avg Lines per Bill' = ```
			DIVIDE (
			    SUMX ( Coverage, Coverage[Lines Per Bill] * Coverage[Outlets Billed] ),
			    SUM ( Coverage[Outlets Billed] )
			)
			```
		formatString: 0.0
		displayFolder: Coverage

	column Date
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: Date

	column ASM
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ASM

	column 'Sales Officer'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Sales Officer

	column 'Total Outlets'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Total Outlets

	column 'Outlets Billed'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Outlets Billed

	column 'Planned Calls'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Planned Calls

	column 'Productive Calls'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Productive Calls

	column 'Lines Per Bill'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: Lines Per Bill

	partition Coverage = m
		mode: import
		source =
				let
					// Rows are embedded as compressed JSON, so no external data source is needed
					#"Decoded Rows" = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
					#"Built Table" = Table.FromRows(#"Decoded Rows", {"Date", "ASM", "Sales Officer", "Total Outlets", "Outlets Billed", "Planned Calls", "Productive Calls", "Lines Per Bill"}),
					#"Set Column Types" = Table.TransformColumnTypes(#"Built Table", {{"Date", type date}, {"ASM", type text}, {"Sales Officer", type text}, {"Total Outlets", Int64.Type}, {"Outlets Billed", Int64.Type}, {"Planned Calls", Int64.Type}, {"Productive Calls", Int64.Type}, {"Lines Per Bill", Currency.Type}}, "en-US")
				in
					#"Set Column Types"

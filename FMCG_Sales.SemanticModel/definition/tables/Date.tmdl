/// Calendar, one row per day from 1 Jan 2025 to 30 Jun 2026.
table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column 'Month Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_number

	column 'Year Month Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: year_month_number

	column 'Month Name'
		dataType: string
		sortByColumn: 'Year Month Number'
		sourceColumn: month_name

	column Month
		dataType: string
		sortByColumn: 'Month Number'
		sourceColumn: month

	column Quarter
		dataType: string
		sourceColumn: quarter

	column 'Financial Year'
		dataType: string
		sourceColumn: financial_year

	partition Date = m
		mode: import
		source =
				let
					// SQL Server connector: server + database -> schema.table
					Source = Sql.Database(#"SQL Server", #"SQL Database"),
					Table = Source{[Schema = "fmcg", Item = "date"]}[Data]
				in
					Table

/// Calendar, one row per day from 1 Jan 2025 to 30 Jun 2026.
table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column 'Month Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Month Number

	column 'Year Month Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Year Month Number

	column 'Month Name'
		dataType: string
		sortByColumn: 'Year Month Number'
		sourceColumn: Month Name

	column Month
		dataType: string
		sortByColumn: 'Month Number'
		sourceColumn: Month

	column Quarter
		dataType: string
		sourceColumn: Quarter

	column 'Financial Year'
		dataType: string
		sourceColumn: Financial Year

	partition Date = m
		mode: import
		source =
				let
					// Rows are embedded as compressed JSON, so no external data source is needed
					#"Decoded Rows" = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
					#"Built Table" = Table.FromRows(#"Decoded Rows", {"Date", "Year", "Month Number", "Year Month Number", "Month Name", "Month", "Quarter", "Financial Year"}),
					#"Set Column Types" = Table.TransformColumnTypes(#"Built Table", {{"Date", type date}, {"Year", Int64.Type}, {"Month Number", Int64.Type}, {"Year Month Number", Int64.Type}, {"Month Name", type text}, {"Month", type text}, {"Quarter", type text}, {"Financial Year", type text}}, "en-US")
				in
					#"Set Column Types"

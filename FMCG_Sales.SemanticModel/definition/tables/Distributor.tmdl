/// Distributors and their location.
table Distributor

	column 'Distributor Code'
		dataType: string
		isKey
		isHidden
		summarizeBy: none
		sourceColumn: distributor_code

	column Distributor
		dataType: string
		sourceColumn: distributor

	column State
		dataType: string
		dataCategory: StateOrProvince
		sourceColumn: state

	column City
		dataType: string
		dataCategory: City
		sourceColumn: city

	partition Distributor = m
		mode: import
		source =
				let
					// Azure Databricks connector: warehouse -> catalog -> schema -> table
					Source = Databricks.Catalogs(#"Databricks Host", #"Databricks HTTP Path", [Catalog = null, Database = null]),
					Catalog = Source{[Name = #"Databricks Catalog", Kind = "Database"]}[Data],
					Schema = Catalog{[Name = #"Databricks Schema", Kind = "Schema"]}[Data],
					Table = Schema{[Name = "distributor", Kind = "Table"]}[Data]
				in
					Table

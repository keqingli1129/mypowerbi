/// Distributors and their location.
table Distributor

	column 'Distributor Code'
		dataType: string
		isKey
		isHidden
		summarizeBy: none
		sourceColumn: Distributor Code

	column Distributor
		dataType: string
		sourceColumn: Distributor

	column State
		dataType: string
		dataCategory: StateOrProvince
		sourceColumn: State

	column City
		dataType: string
		dataCategory: City
		sourceColumn: City

	partition Distributor = m
		mode: import
		source =
				let
					// Rows are embedded as compressed JSON, so no external data source is needed
					#"Decoded Rows" = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
					#"Built Table" = Table.FromRows(#"Decoded Rows", {"Distributor Code", "Distributor", "State", "City"}),
					#"Set Column Types" = Table.TransformColumnTypes(#"Built Table", {{"Distributor Code", type text}, {"Distributor", type text}, {"State", type text}, {"City", type text}}, "en-US")
				in
					#"Set Column Types"

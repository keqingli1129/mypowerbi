/// Distributors and their location.
table Distributor

	column 'Distributor Code'
		dataType: string
		isKey
		isHidden
		summarizeBy: none
		sourceColumn: distributor_code

	column Distributor
		dataType: string
		sourceColumn: distributor

	column State
		dataType: string
		dataCategory: StateOrProvince
		sourceColumn: state

	column City
		dataType: string
		dataCategory: City
		sourceColumn: city

	partition Distributor = m
		mode: import
		source =
				let
					// SQL Server connector: server + database -> schema.table
					Source = Sql.Database(#"SQL Server", #"SQL Database"),
					Table = Source{[Schema = "fmcg", Item = "distributor"]}[Data]
				in
					Table

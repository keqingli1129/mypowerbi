/// Primary (sell-in) invoice lines from the company to distributors.
table 'Primary Sales'

	/// Net value invoiced to distributors (sell-in), after scheme discount.
	measure 'Primary Sales' = SUM ( 'Primary Sales'[Net Primary Value] )
		formatString: ₹#,##0
		displayFolder: Core

	/// Units invoiced to distributors (sell-in).
	measure 'Primary Units' = SUM ( 'Primary Sales'[Units] )
		formatString: #,##0
		displayFolder: Core

	/// Scheme (trade promotion) discount as a share of gross primary value.
	measure 'Scheme Spend %' = DIVIDE ( SUM ( 'Primary Sales'[Scheme Discount] ), SUM ( 'Primary Sales'[Gross Value] ) )
		formatString: 0.0%
		displayFolder: Trade Spend

	/// Text under the primary sales KPI: growth vs last year.
	measure 'Primary Sales Context' = ```
			VAR Growth = [Primary YoY %]
			RETURN
			    IF (
			        ISBLANK ( Growth ),
			        "No prior-year data",
			        IF ( Growth >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Growth ), "0.0%" ) & " vs last year"
			    )
			```
		displayFolder: Report Helpers

	/// Green when sell-in grew vs last year, red when it fell; used for conditional formatting.
	measure 'Primary YoY Color' = ```
			VAR Growth = [Primary YoY %]
			RETURN
			    IF ( NOT ISBLANK ( Growth ), IF ( Growth >= 0, "#1A7F37", "#C62828" ) )
			```
		displayFolder: Report Helpers

	/// Primary Sales for the same period last year. Blank unless one year is in context (data starts in Jan 2025).
	measure 'Primary Sales PY' = ```
			IF (
			    HASONEVALUE ( 'Date'[Year] ),
			    CALCULATE ( [Primary Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
			)
			```
		formatString: ₹#,##0
		displayFolder: Time Intelligence

	/// Growth of primary sales vs the same period last year.
	measure 'Primary YoY %' = ```
			VAR PriorYear = [Primary Sales PY]
			RETURN
			    IF ( NOT ISBLANK ( PriorYear ), DIVIDE ( [Primary Sales] - PriorYear, PriorYear ) )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence

	/// Primary Sales for the previous month.
	measure 'Primary Sales PM' = CALCULATE ( [Primary Sales], DATEADD ( 'Date'[Date], -1, MONTH ) )
		formatString: ₹#,##0
		displayFolder: Time Intelligence

	/// Growth of primary sales vs the previous month.
	measure 'Primary MoM %' = ```
			VAR PriorMonth = [Primary Sales PM]
			RETURN
			    IF ( NOT ISBLANK ( PriorMonth ), DIVIDE ( [Primary Sales] - PriorMonth, PriorMonth ) )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence

	column Date
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: date

	column ASM
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: asm

	column 'Sales Officer'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: sales_officer

	column Category
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: category

	column 'Distributor Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: distributor_code

	column 'SKU Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: sku_code

	column Units
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: units

	column 'Gross Value'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: gross_value

	column 'Scheme Discount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: scheme_discount

	column 'Net Primary Value'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: net_primary_value

	partition 'Primary Sales' = m
		mode: import
		source =
				let
					// SQL Server connector: server + database -> schema.table
					Source = Sql.Database(#"SQL Server", #"SQL Database"),
					Table = Source{[Schema = "fmcg", Item = "primary_sales"]}[Data]
				in
					Table

/// Primary (sell-in) invoice lines from the company to distributors.
table 'Primary Sales'

	/// Net value invoiced to distributors (sell-in), after scheme discount.
	measure 'Primary Sales' = SUM ( 'Primary Sales'[Net Primary Value] )
		formatString: ₹#,##0
		displayFolder: Core

	/// Units invoiced to distributors (sell-in).
	measure 'Primary Units' = SUM ( 'Primary Sales'[Units] )
		formatString: #,##0
		displayFolder: Core

	/// Scheme (trade promotion) discount as a share of gross primary value.
	measure 'Scheme Spend %' = DIVIDE ( SUM ( 'Primary Sales'[Scheme Discount] ), SUM ( 'Primary Sales'[Gross Value] ) )
		formatString: 0.0%
		displayFolder: Trade Spend

	/// Primary Sales for the same period last year. Blank unless one year is in context (data starts in Jan 2025).
	measure 'Primary Sales PY' = ```
			IF (
			    HASONEVALUE ( 'Date'[Year] ),
			    CALCULATE ( [Primary Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
			)
			```
		formatString: ₹#,##0
		displayFolder: Time Intelligence

	/// Growth of primary sales vs the same period last year.
	measure 'Primary YoY %' = ```
			VAR PriorYear = [Primary Sales PY]
			RETURN
			    IF ( NOT ISBLANK ( PriorYear ), DIVIDE ( [Primary Sales] - PriorYear, PriorYear ) )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence

	/// Primary Sales for the previous month.
	measure 'Primary Sales PM' = CALCULATE ( [Primary Sales], DATEADD ( 'Date'[Date], -1, MONTH ) )
		formatString: ₹#,##0
		displayFolder: Time Intelligence

	/// Growth of primary sales vs the previous month.
	measure 'Primary MoM %' = ```
			VAR PriorMonth = [Primary Sales PM]
			RETURN
			    IF ( NOT ISBLANK ( PriorMonth ), DIVIDE ( [Primary Sales] - PriorMonth, PriorMonth ) )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence

	column Date
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: Date

	column ASM
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ASM

	column 'Sales Officer'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Sales Officer

	column Category
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Category

	column 'Distributor Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Distributor Code

	column 'SKU Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SKU Code

	column Units
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Units

	column 'Gross Value'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: Gross Value

	column 'Scheme Discount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: Scheme Discount

	column 'Net Primary Value'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: Net Primary Value

	partition 'Primary Sales' = m
		mode: import
		source =
				let
					// Rows are embedded as compressed JSON, so no external data source is needed
					#"Decoded Rows" = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
					#"Built Table" = Table.FromRows(#"Decoded Rows", {"Date", "ASM", "Sales Officer", "Category", "Distributor Code", "SKU Code", "Units", "Gross Value", "Scheme Discount", "Net Primary Value"}),
					#"Set Column Types" = Table.TransformColumnTypes(#"Built Table", {{"Date", type date}, {"ASM", type text}, {"Sales Officer", type text}, {"Category", type text}, {"Distributor Code", type text}, {"SKU Code", type text}, {"Units", Int64.Type}, {"Gross Value", Currency.Type}, {"Scheme Discount", Currency.Type}, {"Net Primary Value", Currency.Type}}, "en-US")
				in
					#"Set Column Types"

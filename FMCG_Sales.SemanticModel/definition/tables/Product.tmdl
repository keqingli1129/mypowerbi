/// Products at SKU grain with list prices (MRP, PTR = price to retailer, PTS = price to stockist).
table Product

	column 'SKU Code'
		dataType: string
		isKey
		isHidden
		summarizeBy: none
		sourceColumn: SKU Code

	column Brand
		dataType: string
		sourceColumn: Brand

	column SKU
		dataType: string
		sourceColumn: SKU

	column Pack
		dataType: string
		sourceColumn: Pack

	column MRP
		dataType: decimal
		formatString: ₹#,##0.00
		summarizeBy: none
		sourceColumn: MRP

	column 'Units Per Case'
		dataType: int64
		summarizeBy: none
		sourceColumn: Units Per Case

	column PTR
		dataType: decimal
		formatString: ₹#,##0.00
		summarizeBy: none
		sourceColumn: PTR

	column PTS
		dataType: decimal
		formatString: ₹#,##0.00
		summarizeBy: none
		sourceColumn: PTS

	partition Product = m
		mode: import
		source =
				let
					// Rows are embedded as compressed JSON, so no external data source is needed
					#"Decoded Rows" = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
					#"Built Table" = Table.FromRows(#"Decoded Rows", {"SKU Code", "Brand", "SKU", "Pack", "MRP", "Units Per Case", "PTR", "PTS"}),
					#"Set Column Types" = Table.TransformColumnTypes(#"Built Table", {{"SKU Code", type text}, {"Brand", type text}, {"SKU", type text}, {"Pack", type text}, {"MRP", Currency.Type}, {"Units Per Case", Int64.Type}, {"PTR", Currency.Type}, {"PTS", Currency.Type}}, "en-US")
				in
					#"Set Column Types"

/// Products at SKU grain with list prices (MRP, PTR = price to retailer, PTS = price to stockist).
table Product

	column 'SKU Code'
		dataType: string
		isKey
		isHidden
		summarizeBy: none
		sourceColumn: sku_code

	column Brand
		dataType: string
		sourceColumn: brand

	column SKU
		dataType: string
		sourceColumn: sku

	column Pack
		dataType: string
		sourceColumn: pack

	column MRP
		dataType: decimal
		formatString: ₹#,##0.00
		summarizeBy: none
		sourceColumn: mrp

	column 'Units Per Case'
		dataType: int64
		summarizeBy: none
		sourceColumn: units_per_case

	column PTR
		dataType: decimal
		formatString: ₹#,##0.00
		summarizeBy: none
		sourceColumn: ptr

	column PTS
		dataType: decimal
		formatString: ₹#,##0.00
		summarizeBy: none
		sourceColumn: pts

	partition Product = m
		mode: import
		source =
				let
					// SQL Server connector: server + database -> schema.table
					Source = Sql.Database(#"SQL Server", #"SQL Database"),
					Table = Source{[Schema = "fmcg", Item = "product"]}[Data]
				in
					Table

/// Sales officers (SO) and the ASM they report to.
table 'Sales Officer'

	column 'Sales Officer'
		dataType: string
		isKey
		sourceColumn: sales_officer

	column ASM
		dataType: string
		sourceColumn: asm

	partition 'Sales Officer' = m
		mode: import
		source =
				let
					// Azure Databricks connector: warehouse -> catalog -> schema -> table
					Source = Databricks.Catalogs(#"Databricks Host", #"Databricks HTTP Path", [Catalog = null, Database = null]),
					Catalog = Source{[Name = #"Databricks Catalog", Kind = "Database"]}[Data],
					Schema = Catalog{[Name = #"Databricks Schema", Kind = "Schema"]}[Data],
					Table = Schema{[Name = "sales_officer", Kind = "Table"]}[Data]
				in
					Table

/// Sales officers (SO) and the ASM they report to.
table 'Sales Officer'

	column 'Sales Officer'
		dataType: string
		isKey
		sourceColumn: sales_officer

	column ASM
		dataType: string
		sourceColumn: asm

	partition 'Sales Officer' = m
		mode: import
		source =
				let
					// SQL Server connector: server + database -> schema.table
					Source = Sql.Database(#"SQL Server", #"SQL Database"),
					Table = Source{[Schema = "fmcg", Item = "sales_officer"]}[Data]
				in
					Table

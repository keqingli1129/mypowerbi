/// Secondary (sell-out) sales from distributors to retailers, per distributor × SKU × channel × month.
table 'Secondary Sales'

	/// Value sold by distributors to retailers (sell-out).
	measure 'Secondary Sales' = SUM ( 'Secondary Sales'[Secondary Value] )
		formatString: ₹#,##0
		displayFolder: Core

	/// Units sold by distributors to retailers (sell-out).
	measure 'Secondary Units' = SUM ( 'Secondary Sales'[Units Sold] )
		formatString: #,##0
		displayFolder: Core

	/// Secondary units ÷ primary units: how much of what was sold in actually moved to retailers.
	measure 'Sell-Through %' = DIVIDE ( [Secondary Units], [Primary Units] )
		formatString: 0.0%
		displayFolder: Pipeline

	/// Cumulative primary minus secondary units, from the start of the data to the last selected date.
	measure 'Pipeline Stock Units' = ```
			VAR CutoffDate = MAX ( 'Date'[Date] )
			RETURN
			    CALCULATE (
			        [Primary Units] - [Secondary Units],
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Date] <= CutoffDate
			    )
			```
		formatString: #,##0
		displayFolder: Pipeline

	/// This category's share of secondary sales within the current filters.
	measure 'Category Mix %' = DIVIDE ( [Secondary Sales], CALCULATE ( [Secondary Sales], REMOVEFILTERS ( Category ) ) )
		formatString: 0.0%
		displayFolder: Core

	/// Text under the secondary sales KPI: growth vs last year.
	measure 'Secondary Sales Context' = ```
			VAR Growth = [Secondary YoY %]
			RETURN
			    IF (
			        ISBLANK ( Growth ),
			        "No prior-year data",
			        IF ( Growth >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Growth ), "0.0%" ) & " vs last year"
			    )
			```
		displayFolder: Report Helpers

	/// Text under the sell-through KPI: share of units not yet sold on to retailers.
	measure 'Sell-Through Context' = ```
			VAR SellThrough = [Sell-Through %]
			RETURN
			    IF ( NOT ISBLANK ( SellThrough ), FORMAT ( 1 - SellThrough, "0.0%" ) & " of units still with distributors" )
			```
		displayFolder: Report Helpers

	/// Text under the distributor stock KPI: units added to stock in the selected period.
	measure 'Pipeline Stock Context' = ```
			VAR Added = [Primary Units] - [Secondary Units]
			RETURN
			    IF (
			        NOT ISBLANK ( Added ),
			        IF ( Added >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Added ), "#,##0" ) & " units added this period"
			    )
			```
		displayFolder: Report Helpers

	/// Secondary Sales for the same period last year. Blank unless one year is in context (data starts in Jan 2025).
	measure 'Secondary Sales PY' = ```
			IF (
			    HASONEVALUE ( 'Date'[Year] ),
			    CALCULATE ( [Secondary Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
			)
			```
		formatString: ₹#,##0
		displayFolder: Time Intelligence

	/// Growth of secondary sales vs the same period last year.
	measure 'Secondary YoY %' = ```
			VAR PriorYear = [Secondary Sales PY]
			RETURN
			    IF ( NOT ISBLANK ( PriorYear ), DIVIDE ( [Secondary Sales] - PriorYear, PriorYear ) )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence

	/// Secondary Sales for the previous month.
	measure 'Secondary Sales PM' = CALCULATE ( [Secondary Sales], DATEADD ( 'Date'[Date], -1, MONTH ) )
		formatString: ₹#,##0
		displayFolder: Time Intelligence

	/// Growth of secondary sales vs the previous month.
	measure 'Secondary MoM %' = ```
			VAR PriorMonth = [Secondary Sales PM]
			RETURN
			    IF ( NOT ISBLANK ( PriorMonth ), DIVIDE ( [Secondary Sales] - PriorMonth, PriorMonth ) )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence

	column Date
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: Date

	column ASM
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ASM

	column 'Sales Officer'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Sales Officer

	column Category
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Category

	column 'Distributor Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Distributor Code

	column 'SKU Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SKU Code

	column Channel
		dataType: string
		sourceColumn: Channel

	column 'Units Sold'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Units Sold

	column 'Secondary Value'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: Secondary Value

	partition 'Secondary Sales' = m
		mode: import
		source =
				let
					// Rows are embedded as compressed JSON, so no external data source is needed
					#"Decoded Rows" = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
					#"Built Table" = Table.FromRows(#"Decoded Rows", {"Date", "ASM", "Sales Officer", "Category", "Distributor Code", "SKU Code", "Channel", "Units Sold", "Secondary Value"}),
					#"Set Column Types" = Table.TransformColumnTypes(#"Built Table", {{"Date", type date}, {"ASM", type text}, {"Sales Officer", type text}, {"Category", type text}, {"Distributor Code", type text}, {"SKU Code", type text}, {"Channel", type text}, {"Units Sold", Int64.Type}, {"Secondary Value", Currency.Type}}, "en-US")
				in
					#"Set Column Types"

/// Monthly primary and secondary targets per ASM × Category (dated the first of the month).
table Targets

	/// Primary (sell-in) target, set per ASM × Category × Month.
	measure 'Primary Target' = SUM ( Targets[Primary Target Value] )
		formatString: ₹#,##0
		displayFolder: Targets

	/// Secondary (sell-out) target, set per ASM × Category × Month.
	measure 'Secondary Target' = SUM ( Targets[Secondary Target Value] )
		formatString: ₹#,##0
		displayFolder: Targets

	/// Primary sales ÷ primary target.
	measure 'Primary Achievement %' = DIVIDE ( [Primary Sales], [Primary Target] )
		formatString: 0.0%
		displayFolder: Achievement

	/// Secondary sales ÷ secondary target.
	measure 'Secondary Achievement %' = DIVIDE ( [Secondary Sales], [Secondary Target] )
		formatString: 0.0%
		displayFolder: Achievement

	/// Primary sales minus primary target; negative means behind target.
	measure 'Primary Gap to Target' = ```
			VAR TargetValue = [Primary Target]
			RETURN
			    IF ( NOT ISBLANK ( TargetValue ), [Primary Sales] - TargetValue )
			```
		formatString: ₹#,##0
		displayFolder: Achievement

	/// Text under the % of target KPI: rupee gap to the primary target.
	measure 'Achievement Context' = ```
			VAR Gap = [Primary Gap to Target]
			RETURN
			    IF (
			        ISBLANK ( Gap ),
			        "No target set",
			        IF ( Gap >= 0, "▲ ₹", "▼ ₹" ) & FORMAT ( ABS ( Gap ) / 1000000, "0.0" ) & "M "
			            & IF ( Gap >= 0, "above", "below" ) & " target"
			    )
			```
		displayFolder: Report Helpers

	/// Green at or above 100% of primary target, red below; used for conditional formatting.
	measure 'Achievement Color' = ```
			VAR Achievement = [Primary Achievement %]
			RETURN
			    IF ( NOT ISBLANK ( Achievement ), IF ( Achievement >= 1, "#1A7F37", "#C62828" ) )
			```
		displayFolder: Report Helpers

	column Date
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: date

	column ASM
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: asm

	column Category
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: category

	column 'Primary Target Value'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: primary_target_value

	column 'Secondary Target Value'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: secondary_target_value

	partition Targets = m
		mode: import
		source =
				let
					// SQL Server connector: server + database -> schema.table
					Source = Sql.Database(#"SQL Server", #"SQL Database"),
					Table = Source{[Schema = "fmcg", Item = "targets"]}[Data]
				in
					Table
